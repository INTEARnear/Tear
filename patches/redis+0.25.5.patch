-    let TlsCertificates {
-        client_tls,
-        root_cert,
-    } = certificates;
-
-    let client_tls_params = if let Some(ClientTlsConfig {
-        client_cert,
-        client_key,
-    }) = client_tls
-    {
-        let buf = &mut client_cert.as_slice() as &mut dyn BufRead;
-        let certs = rustls_pemfile::certs(buf);
-        let client_cert_chain = certs.collect::<Result<Vec<_>, _>>()?;
