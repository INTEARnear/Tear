-    // result is ignored, as per the command's instructions.
-    // https://redis.io/commands/client-setinfo/
-    #[cfg(not(feature = "disable-client-setinfo"))]
-    let _: RedisResult<()> = client_set_info_pipeline().query(&mut rv);
