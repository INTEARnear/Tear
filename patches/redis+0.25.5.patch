-
-    /// This only exists internally as a workaround for the lack of
-    /// specialization.
-    #[doc(hidden)]
-    fn make_arg_iter_ref<'a, I, W>(items: I, out: &mut W)
-    where
-        W: ?Sized + RedisWrite,
-        I: Iterator<Item = &'a Self>,
-        Self: 'a,
