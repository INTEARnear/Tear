-                let addr = redis::ConnectionAddr::TcpTls {
-                    host: host.clone(),
-                    port,
-                    insecure,
-                    tls_params: None,
-                };
-
-                RedisServer {
-                    process: spawner(&mut redis_cmd),
-                    tempdir,
-                    addr,
-                    tls_paths: Some(tls_paths),
-                }
-            }
-            redis::ConnectionAddr::Unix(ref path) => {
-                redis_cmd
-                    .arg("--port")
-                    .arg("0")
-                    .arg("--unixsocket")
-                    .arg(path);
-                RedisServer {
-                    process: spawner(&mut redis_cmd),
-                    tempdir,
-                    addr,
-                    tls_paths: None,
-                }
-            }
-        }
-    }
