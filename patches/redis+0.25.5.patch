-        .collect::<Vec<&String>>();
-
-    // sleep for 5ms
-    sleep(Duration::from_millis(5));
-
-    // grab this id if > 4ms
-    let reply: StreamClaimReply = con
-        .xclaim("k1", "g1", "c2", 4, &[claim.id.clone()])
-        .unwrap();
