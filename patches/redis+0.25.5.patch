-        .into_iter()
-        .filter(move |info| validate(info))
-        .map(|mut info| {
-            // We can unwrap here because we already checked everything
-            let ip = info.remove("ip").unwrap();
-            let port = info["port"].parse::<u16>().unwrap();
-            (ip, port)
