-//! use redis::sentinel::{ SentinelServerType, SentinelClient, SentinelNodeConnectionInfo };
-//!
-//! let nodes = vec!["redis://127.0.0.1:6379/", "redis://127.0.0.1:6378/", "redis://127.0.0.1:6377/"];
