-                    Err(io::Error::new(
-                        err,
-                        "error during read, generated by partial-io",
-                    ))
-                    .into()
-                }
-            }
-            Some(PartialOp::Unlimited) | None => Pin::new(&mut self.inner).poll_read(cx, buf),
-        }
-    }
-}
