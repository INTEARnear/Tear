+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn text_message_from_private_chat() {
+        let json = r#"{
+            "origin": {
+                "type": "user",
+                "sender_user": {"id": 1, "is_bot": false, "first_name": "A"},
+                "date": 1700000000
+            }
+        }"#;
+        let info: ExternalReplyInfo = serde_json::from_str(json).unwrap();
+        assert_eq!(info.message_id, None);
+        assert_eq!(info.kind, None);
+    }
+
+    #[test]
+    fn dice_message_from_supergroup() {
+        let json = r#"{
+            "origin": {
+                "type": "user",
+                "sender_user": {"id": 1, "is_bot": false, "first_name": "A"},
+                "date": 1700000000
+            },
+            "chat": {"id": -1001, "type": "supergroup", "title": "G"},
+            "message_id": 5,
+            "dice": {"emoji": "🎲", "value": 3}
+        }"#;
+        let info: ExternalReplyInfo = serde_json::from_str(json).unwrap();
+        assert_eq!(info.message_id, Some(MessageId(5)));
+        assert!(matches!(info.kind, Some(ExternalReplyInfoKind::Dice(_))));
+    }
+}
